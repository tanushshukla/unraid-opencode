#!/bin/bash
set -euo pipefail
umask 077
BASE=/mnt/user/appdata/opencode
PLUGIN=/usr/local/emhttp/plugins/opencode
fail() { echo "OpenCode: $*" >&2; exit 1; }
mounted() { mountpoint -q /mnt/user; }
prepare() {
    mounted || fail 'Start the array first; /mnt/user is not mounted.'
    mkdir -p "$BASE"/{bin,config,data,state,cache}
    chmod 700 "$BASE"
    # Copy once; retain the original files and preserve existing appdata files.
    if [[ ! -e "$BASE/.migrated" ]]; then
        if pgrep -x opencode >/dev/null; then
            fail 'Close existing OpenCode sessions before the first migration.'
        fi
        for pair in '.config config' '.local/share data' '.local/state state'; do
            read -r src dest <<< "$pair"
            if [[ -d "/root/$src/opencode" ]]; then
                mkdir -p "$BASE/$dest/opencode"
                cp -an "/root/$src/opencode/." "$BASE/$dest/opencode/"
            fi
        done
        touch "$BASE/.migrated"
    fi
}
# Print the version reported by an executable, or nothing if it cannot run.
binary_version() {
    timeout 30 "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^[:space:]]*' | head -n 1 || true
}
# OpenCode 1.x and 2.x share appdata but differ in database and configuration format.
series() { case $1 in 1.*) echo 1 ;; '') echo unknown ;; *) echo 2 ;; esac; }
# OpenCode 2 runs a detached background server that would otherwise outlive sessions.
stop_service() {
    [[ -x "$BASE/bin/opencode" ]] || return 0
    if [[ $(series "$(binary_version "$BASE/bin/opencode")") == 2 ]]; then
        timeout 60 "$BASE/bin/opencode" service stop >/dev/null 2>&1 || true
    fi
    pkill -TERM -f "^$BASE/bin/opencode(\.previous)? serve --service" || true
}
# Replace the active binary; back up the database and configuration across 1.x/2.x changes.
activate() {
    local new=$1 old_version new_version backup
    new_version=$(binary_version "$new")
    if [[ -f "$BASE/bin/opencode" ]]; then
        old_version=$(binary_version "$BASE/bin/opencode")
        if [[ $(series "$old_version") != $(series "$new_version") ]]; then
            stop_service
            if pgrep -x opencode >/dev/null; then
                fail 'Close all OpenCode sessions before switching between OpenCode 1 and 2; existing binary retained.'
            fi
            backup="$BASE/backup/${old_version:-unknown}-$(date +%Y%m%d-%H%M%S)"
            mkdir -p "$backup/data"
            cp -a "$BASE/config/opencode" "$backup/config" 2>/dev/null || true
            cp -a "$BASE/data/opencode/"opencode*.db* "$backup/data/" 2>/dev/null || true
            echo "Backed up database and configuration to $backup"
        fi
        cp -p "$BASE/bin/opencode" "$BASE/bin/.previous.tmp"
    fi
    mv -f "$new" "$BASE/bin/opencode"
    if [[ -f "$BASE/bin/.previous.tmp" ]]; then
        mv -f "$BASE/bin/.previous.tmp" "$BASE/bin/opencode.previous"
    fi
}
install_binary() (
    local version=${1:-latest} target=linux-x64 url stage meta scope integrity expected
    [[ $(uname -m) == x86_64 ]] || fail 'This plugin currently supports x86_64 only.'
    [[ "$version" == latest || "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || fail 'Invalid version.'
    version=${version#v}
    grep -qwi avx2 /proc/cpuinfo || target=linux-x64-baseline
    stage=$(mktemp -d "$BASE/.install.XXXXXX")
    trap 'rm -rf -- "$stage"' EXIT
    get() { curl --fail --location --show-error --silent --connect-timeout 20 --max-time 600 --retry 2 "$@"; }
    if [[ "$version" == 1.* ]]; then
        # OpenCode 1.x is published as GitHub release assets without checksums.
        url="https://github.com/anomalyco/opencode/releases/download/v$version/opencode-$target.tar.gz"
        get "$url" -o "$stage/release.tar.gz" || fail 'Download failed; existing binary retained.'
        # Extract only the expected executable, never arbitrary archive paths.
        tar -xzf "$stage/release.tar.gz" -C "$stage" --no-same-owner --no-same-permissions opencode || fail 'Invalid release archive.'
    else
        # OpenCode 2 is published to npm, as used by https://opencode.ai/v2/install.
        scope=@opencode
        if [[ "$version" == latest ]]; then
            meta=$(get https://opencode.ai/update/api/latest/cli/npm) || fail 'Could not fetch the latest version; existing binary retained.'
            version=$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' <<< "$meta")
            scope=$(sed -n 's/.*"package":"\([^"]*\)\/cli".*/\1/p' <<< "$meta")
            [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ && "$scope" =~ ^@opencode(-ai)?$ ]] || fail 'Unexpected version information.'
        fi
        # Older releases were published under the previous package scope.
        meta=$(get "https://registry.npmjs.org/$scope%2fcli-$target/$version" 2>/dev/null) || {
            scope=@opencode-ai
            meta=$(get "https://registry.npmjs.org/$scope%2fcli-$target/$version") || fail "Version $version is not available for $target."
        }
        integrity=$(grep -oE '"integrity":"sha512-[A-Za-z0-9+/=]+"' <<< "$meta" | head -n 1 | sed 's/.*sha512-\([^"]*\)"/\1/')
        [[ -n "$integrity" ]] || fail 'Missing package checksum.'
        get "https://registry.npmjs.org/$scope/cli-$target/-/cli-$target-$version.tgz" -o "$stage/release.tgz" || fail 'Download failed; existing binary retained.'
        expected=$(base64 -d <<< "$integrity" | od -An -vtx1 | tr -d ' \n')
        [[ $(sha512sum "$stage/release.tgz" | cut -d' ' -f1) == "$expected" ]] || fail 'Checksum mismatch; existing binary retained.'
        tar -xzf "$stage/release.tgz" -C "$stage" --no-same-owner --no-same-permissions package/bin/opencode || fail 'Invalid release archive.'
        [[ -f "$stage/package/bin/opencode" && ! -L "$stage/package/bin/opencode" ]] || fail 'Missing executable.'
        mv "$stage/package/bin/opencode" "$stage/opencode"
    fi
    [[ -f "$stage/opencode" && ! -L "$stage/opencode" ]] || fail 'Missing executable.'
    chmod 700 "$stage/opencode"
    timeout 30 "$stage/opencode" --version || fail 'Binary cannot run on this server; existing binary retained.'
    activate "$stage/opencode"
    echo 'OpenCode binary installed successfully.'
)
case "${1:-ensure}" in
    boot)
        for ((attempt=0; attempt<120; attempt++)); do
            mounted && exec "$0" ensure
            sleep 5
        done
        echo 'Array not mounted yet. Run opencode after starting the array.'
        exit 0
        ;;
    stop)
        mounted || exit 0
        export XDG_CONFIG_HOME="$BASE/config" XDG_DATA_HOME="$BASE/data"
        export XDG_STATE_HOME="$BASE/state" XDG_CACHE_HOME="$BASE/cache"
        stop_service
        ;;
    ensure|update|rollback)
        mounted || fail 'Start the array first; /mnt/user is not mounted.'
        exec 9>/var/lock/opencode-plugin.lock
        flock -w 660 9 || fail 'Another installation is in progress.'
        prepare
        export XDG_CONFIG_HOME="$BASE/config" XDG_DATA_HOME="$BASE/data"
        export XDG_STATE_HOME="$BASE/state" XDG_CACHE_HOME="$BASE/cache"
        case "${1:-ensure}" in
            ensure) [[ -x "$BASE/bin/opencode" ]] || install_binary ;;
            update) install_binary "${2:-latest}" ;;
            rollback) (
                [[ -x "$BASE/bin/opencode.previous" ]] || fail 'No previous binary available.'
                trap 'rm -f -- "$BASE/bin/opencode.restore"' EXIT
                cp -p "$BASE/bin/opencode.previous" "$BASE/bin/opencode.restore"
                activate "$BASE/bin/opencode.restore"
                echo "Previous OpenCode binary restored. Database backups, if any, are in $BASE/backup"
                ) ;;
        esac
        ;;
    *) fail 'Usage: opencode-manager {ensure|update [version]|rollback|stop|boot}' ;;
esac
